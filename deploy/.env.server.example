# Jarvis server settings. Copy to .env next to docker-compose.yml and keep it private (chmod 600).

# --- Web ---
JARVIS_PUBLIC_URL=https://jarvis.keeeys.uk
JARVIS_TIMEZONE=Europe/London
# Docker network SWAG is attached to (see `docker inspect swag`); used by docker-compose.yml
SWAG_NETWORK=swag_default

# --- Model: Ollama on the PC (GPU) ---
JARVIS_OLLAMA_URL=http://192.168.1.50:11434
JARVIS_MODEL=llama3.2:3b
# Optional smaller/faster model for routing; defaults to JARVIS_MODEL
# JARVIS_ROUTER_MODEL=llama3.2:3b
# How long Ollama keeps the model in GPU memory after each request: -1 = until Ollama is closed (default),
# or a duration such as 2h. Jarvis also loads it as soon as Ollama comes online. Quit Ollama to free the GPU.
# JARVIS_OLLAMA_KEEP_ALIVE=-1
# Bible passages ("read me Philippians 1") come verbatim from bible-api.com. Public-domain translations only:
# webbe (World English Bible, British Edition — default), web, kjv, oeb-cw (Open English Bible, Commonwealth), bbe
# JARVIS_BIBLE_TRANSLATION=webbe

# --- Vault: an Obsidian vault folder inside your Nextcloud files ---
VAULT_BACKEND=files
# Host path of the vault folder INSIDE Nextcloud's data directory (mounted read-only into Jarvis)
VAULT_HOST_PATH=/srv/nextcloud/data/chris/files/Obsidian/Jarvis
# Group that owns Nextcloud's data (33 = www-data in the official image; your PGID for linuxserver/nextcloud)
VAULT_GID=33
# Jarvis writes through Nextcloud (WebDAV) so Nextcloud and your devices see changes immediately
VAULT_WRITE=nextcloud
NEXTCLOUD_URL=https://nextcloud.keeeys.uk
NEXTCLOUD_USER=chris
# Nextcloud → Personal settings → Security → "Create new app password"
NEXTCLOUD_APP_PASSWORD=
# The same folder as VAULT_HOST_PATH, as seen in Nextcloud (relative to your files)
NEXTCLOUD_VAULT_DIR=Obsidian/Jarvis
# Name of the vault in Obsidian on your devices (used for obsidian:// links)
OBSIDIAN_VAULT_NAME=Jarvis

# Alternative (old setup): Obsidian on the PC with the Local REST API plugin
# VAULT_BACKEND=obsidian
# OBSIDIAN_URL=https://192.168.1.50:27124
# OBSIDIAN_API_KEY=
# OBSIDIAN_CA_CERT=/certs/obsidian-ca.crt

# --- Google (Web application OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_IDS=primary

# --- Home Assistant (status questions + confirmed/scheduled actions) ---
# Create a long-lived token in HA: your profile → Security → Long-lived access tokens
HA_URL=http://192.168.1.20:8123
HA_TOKEN=
# HA_VERIFY_TLS=true

# --- Morning brief ---
BRIEF_TIME=07:30
# Evening preview of tomorrow (calendar, early start, booking refs, reminders, parcels, weather); "off" to disable
EVENING_TIME=21:00
# For the weather line (Open-Meteo, no key needed). Rough coordinates are fine.
BRIEF_LATITUDE=53.80
BRIEF_LONGITUDE=-1.55
BRIEF_PLACE=Leeds
# Home Assistant sensors to include, comma-separated (e.g. bin collection, outside temperature)
BRIEF_HA_ENTITIES=

# --- Notifications (ntfy container on the same Docker network) ---
NTFY_URL=http://ntfy:80
NTFY_TOPIC=jarvis
NTFY_TOKEN=
# Comma-separated addresses or @domains that always notify
NOTIFY_VIP_SENDERS=
# Comma-separated words in subject/snippet that notify
NOTIFY_KEYWORDS=urgent,invoice due,delivery
NOTIFY_QUIET_HOURS=22:00-07:00
NOTIFY_EVENT_LEAD_MINUTES=60
NOTIFY_MAX_PER_HOUR=10

# Tell you what Jarvis saved to the vault: "summary" (ntfy digest, at most every N minutes) or "off".
# The chat timeline always shows what was saved.
NOTIFY_VAULT_SAVES=summary
NOTIFY_VAULT_SAVES_MINUTES=15

# --- Events from email -> Google Calendar ---
# Max emails per day read by the model to find events (invites/bookings are parsed without the model)
EVENTS_LLM_DAILY_LIMIT=150
# off = always ask before adding (recommended); ics = auto-add exact calendar invitations (.ics)
EVENTS_AUTO_ADD=off
EVENTS_CALENDAR_ID=primary

# --- Voice (spoken replies) ---
# kokoro (local Kokoro-82M container), elevenlabs (cloud), or browser (device voice, no setup)
JARVIS_TTS_PROVIDER=kokoro
JARVIS_TTS_URL=http://kokoro:8880
# British voices: bm_george, bm_lewis, bm_fable, bm_daniel, bf_emma, bf_isabella, bf_alice, bf_lily
JARVIS_TTS_VOICE=bm_george
JARVIS_TTS_SPEED=1.0
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Internet lookups (general questions) ---
# searxng (private SearXNG container, default), brave (Brave Search API key), or off
WEB_SEARCH_PROVIDER=searxng
SEARXNG_URL=http://searxng:8080
# BRAVE_API_KEY=
# How many result pages Jarvis reads for each question
WEB_FETCH_PAGES=3
WEB_CACHE_MINUTES=60
WEB_LANGUAGE=en-GB

# --- Diagnostics ---
# info (default) or debug. Debug records prompts and request/response bodies; it can also be
# switched on for an hour from Logs → Verbose.
JARVIS_LOG_LEVEL=info
JARVIS_LOG_RETENTION_DAYS=7

# --- Ingestion ---
INGEST_GMAIL_INTERVAL=300
INGEST_CALENDAR_INTERVAL=900
INGEST_BACKFILL_DAYS=30

# Only trust X-Forwarded-For from SWAG (its container IP or the Docker network's subnet). Default: any.
# JARVIS_TRUSTED_PROXIES=172.18.0.0/16
